        reg add "HKLM\SOFTWARE\Microsoft\DirectX" /v MaxFrameQueueSize /t REG_DWORD /d 1 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Microsoft\Direct3D" /v MaxPreRenderedFrames /t REG_DWORD /d 1 /f 2>$null | Out-Null
    },
    # Task 15: Vendor Specific GPU Tweaks
