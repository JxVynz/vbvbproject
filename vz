# Helper function for rendering progress bar
function Show-Progress {
    param ([int]$percent)
    $totalBlocks = 32
    $fillCount = [math]::Floor(($percent / 100) * $totalBlocks)
    $emptyCount = $totalBlocks - $fillCount
    $bar = "#" * $fillCount + " " * $emptyCount
    $padPercent = "{0,3}" -f $percent
    Write-Host -NoNewline "`r[$bar] $padPercent%" -ForegroundColor Green
}

# List of Master FPS Tweaks
$tasks = @(
    # Task 1: Force Ultimate Power Scheme & Enable
    {
        $ultGuid = "e9a42b02-d5df-448d-aa00-03f14749eb61"
        if (-not (powercfg -list | Select-String $ultGuid)) {
            powercfg -duplicatescheme $ultGuid 2>$null | Out-Null
        }
        if (powercfg -list | Select-String $ultGuid) {
            powercfg -setactive $ultGuid 2>$null | Out-Null
            $global:IsUltimateActive = $true
        } else {
            $global:IsUltimateActive = $false
        }
    },
    # Task 2: CPU Unpark, CPPC Idle & EPP Off (Applies ONLY if Ultimate Performance is active)
    {
        if ($global:IsUltimateActive) {
            $currentScheme = "e9a42b02-d5df-448d-aa00-03f14749eb61"
            powercfg -setacvalueindex $currentScheme SUB_PROCESSOR CPMINCORES 100 2>$null | Out-Null
            powercfg -setacvalueindex $currentScheme SUB_PROCESSOR CPMAXCORES 100 2>$null | Out-Null
            
            $ppPath = "HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\54533251-82be-4824-96c1-47b60b740d00\0cc5b647-c1df-4637-891a-dec35c318583"
            reg add "$ppPath" /v ValueMin /t REG_DWORD /d 100 /f 2>$null | Out-Null
