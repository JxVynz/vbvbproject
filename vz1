    # Task 29: Disable DistributedCOM Overhead
    {
        Set-SilentRegistry -Path "HKLM:\SOFTWARE\Microsoft\Ole" -Name "EnableDCOM" -Value "Y" -PropertyType "String"
        Set-SilentRegistry -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows\EventLog\Application" -Name "MaxSize" -Value 1048576
    },
    # Task 30: Dynamic SvcHost Splitting
    {
        $splitValueKB = [int]($global:ramGB * 1024 * 1024)
        Set-SilentRegistry -Path "HKLM:\SYSTEM\CurrentControlSet\Control" -Name "SvcHostSplitThresholdInKB" -Value $splitValueKB
    },
    # Task 31: High-Precision Global Timer
    {
        Set-SilentRegistry -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" -Name "GlobalTimerResolutionRequests" -Value 1
    },
    # Task 32: Disable SysMain & Search Services
    {
        $services = @("SysMain", "WSearch")
        foreach ($svc in $services) {
            if (Get-Service $svc -ErrorAction SilentlyContinue) {
                Set-Service $svc -StartupType Disabled -ErrorAction SilentlyContinue
                Stop-Service $svc -Force -ErrorAction SilentlyContinue
            }
        }
    }
)

# Run Tasks and update loading bar
Show-Progress -percent 0
for ($i = 0; $i -lt $tasks.Count; $i++) {
    & $tasks[$i]
    $pct = [math]::Floor((($i + 1) / $tasks.Count) * 100)
    Show-Progress -percent $pct
    Start-Sleep -Milliseconds 40
}

Write-Host ""
Write-Host ""

# Completion Message
$msg = "[+] Successfully Please Restart PC ! ! !"
for ($f = 0; $f -lt 6; $f++) {
    Write-Host -NoNewline "`r$msg" -ForegroundColor Green
    Start-Sleep -Milliseconds 350
    Write-Host -NoNewline "`r                                                        "
    Start-Sleep -Milliseconds 250
}
Write-Host "`r$msg" -ForegroundColor Green

Write-Host ""
Write-Host "/--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--\" -ForegroundColor DarkGray
Write-Host ""
