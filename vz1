# =======================================================
# Run as Administrator Check
# =======================================================
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "[!] Please run this script as Administrator!" -ForegroundColor Red
    Start-Sleep -Seconds 3
    exit
}

Clear-Host

# 1. Header Display
Write-Host "+-------------------------------------------------------+" -ForegroundColor Cyan
Write-Host "|                                                       |" -ForegroundColor Cyan
Write-Host "|                   JAME VBVB TWEAKS                    |" -ForegroundColor Yellow
Write-Host "|                                                       |" -ForegroundColor Cyan
Write-Host "+-------------------------------------------------------+" -ForegroundColor Cyan
Write-Host ""

# 2. Dynamic Hardware & OS Detection
$os = Get-CimInstance Win32_OperatingSystem
$osName = $os.Caption -replace "Microsoft ", ""
$cpu = (Get-CimInstance Win32_Processor).Name.Trim()
$gpuList = Get-CimInstance Win32_VideoController
$gpuMain = $gpuList | Select-Object -First 1
$gpuName = $gpuMain.Name.Trim()

$totalRamBytes = (Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory
$global:ramGB = [math]::Round($totalRamBytes / 1GB)

# Multi-GPU Brands Check
$hasNvidia = $false; $hasAMD = $false; $hasIntel = $false
foreach ($g in $gpuList) {
    if ($g.Name -match "NVIDIA") { $hasNvidia = $true }
    if ($g.Name -match "AMD" -or $g.Name -match "Radeon") { $hasAMD = $true }
    if ($g.Name -match "Intel") { $hasIntel = $true }
}

$gpuBrandTag = "UNKNOWN"
if ($hasNvidia) { $gpuBrandTag = "NVIDIA" }
elseif ($hasAMD) { $gpuBrandTag = "AMD" }
elseif ($hasIntel) { $gpuBrandTag = "INTEL" }

# Print Specs
Write-Host "- PC Specs :" -ForegroundColor Yellow
Write-Host -NoNewline "  [" -ForegroundColor White
Write-Host -NoNewline "CPU" -ForegroundColor Cyan
Write-Host -NoNewline "] : " -ForegroundColor White
Write-Host "$cpu" -ForegroundColor Green

Write-Host -NoNewline "  [" -ForegroundColor White
Write-Host -NoNewline "GPU" -ForegroundColor Cyan
Write-Host -NoNewline "] : " -ForegroundColor White
Write-Host "$gpuName ($gpuBrandTag)" -ForegroundColor Green

Write-Host -NoNewline "  [" -ForegroundColor White
Write-Host -NoNewline "RAM" -ForegroundColor Cyan
Write-Host -NoNewline "] : " -ForegroundColor White
Write-Host "$global:ramGB GB" -ForegroundColor Green

Write-Host -NoNewline "  [" -ForegroundColor White
Write-Host -NoNewline "OS " -ForegroundColor Cyan
Write-Host -NoNewline "] : " -ForegroundColor White
Write-Host "$osName" -ForegroundColor Green

Write-Host ""

# 3. FiveM Path Check
$fivemPath = "$env:LOCALAPPDATA\FiveM"
$fivemAppPath = "$env:LOCALAPPDATA\FiveM\FiveM.app"
$global:FiveMFound = $false
$detectedPath = ""

if (Test-Path $fivemAppPath) {
    $detectedPath = $fivemAppPath
    $global:FiveMFound = $true
} elseif (Test-Path $fivemPath) {
    $detectedPath = $fivemPath
    $global:FiveMFound = $true
}

Write-Host -NoNewline "- FiveM Path Check : " -ForegroundColor Yellow
if ($global:FiveMFound) {
    Write-Host -NoNewline "[" -ForegroundColor White
    Write-Host -NoNewline "Found" -ForegroundColor Green
    Write-Host -NoNewline "] : " -ForegroundColor White
    Write-Host "$detectedPath" -ForegroundColor DarkGray
} else {
    Write-Host -NoNewline "[" -ForegroundColor White
    Write-Host -NoNewline "Not Found" -ForegroundColor Red
    Write-Host "]" -ForegroundColor White
}

Write-Host ""
Write-Host "/--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--\" -ForegroundColor DarkGray
Write-Host ""
Write-Host "Applying Jamevbvb Tweaks. . ." -ForegroundColor Yellow

# Helper function for rendering progress bar
function Show-Progress {
    param ([int]$percent)
    $totalBlocks = 32
    $fillCount = [math]::Floor(($percent / 100) * $totalBlocks)
    $emptyCount = $totalBlocks - $fillCount
    $bar = "#" * $fillCount + " " * $emptyCount
    $padPercent = "{0,3}" -f $percent
    Write-Host -NoNewline "`r[$bar] $padPercent%" -ForegroundColor Green
}

# List of Master FPS Tweaks
$tasks = @(
    # Task 1: Force Ultimate Power Scheme & Enable
    {
        $ultGuid = "e9a42b02-d5df-448d-aa00-03f14749eb61"
        if (-not (powercfg -list | Select-String $ultGuid)) {
            powercfg -duplicatescheme $ultGuid 2>$null | Out-Null
        }
        if (powercfg -list | Select-String $ultGuid) {
            powercfg -setactive $ultGuid 2>$null | Out-Null
            $global:IsUltimateActive = $true
        } else {
            $global:IsUltimateActive = $false
        }
    },
    # Task 2: CPU Unpark & EPP Off (Applies ONLY if Ultimate Performance is active)
    {
        if ($global:IsUltimateActive) {
            $currentScheme = "e9a42b02-d5df-448d-aa00-03f14749eb61"
            powercfg -setacvalueindex $currentScheme SUB_PROCESSOR CPMINCORES 100 2>$null | Out-Null
            powercfg -setacvalueindex $currentScheme SUB_PROCESSOR CPMAXCORES 100 2>$null | Out-Null
            
            $ppPath = "HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\54533251-82be-4824-96c1-47b60b740d00\0cc5b647-c1df-4637-891a-dec35c318583"
            reg add "$ppPath" /v ValueMin /t REG_DWORD /d 100 /f 2>$null | Out-Null
            reg add "$ppPath" /v ValueMax /t REG_DWORD /d 100 /f 2>$null | Out-Null

            $eppPath = "HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\54533251-82be-4824-96c1-47b60b740d00\3b0458f5-100f-4f29-b357-225fda4a7802"
            reg add "$eppPath" /v Attributes /t REG_DWORD /d 2 /f 2>$null | Out-Null
            
            powercfg -setacvalueindex $currentScheme SUB_PROCESSOR PERFEPP 0 2>$null | Out-Null
            powercfg -setactive $currentScheme 2>$null | Out-Null
        }
    },
    # Task 3: Priority Control, Win32Separation & IRQ Priority
    {
        reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v ConvertibleSlateMode /t REG_DWORD /d 0 /f 2>$null | Out-Null
        reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v Win32PrioritySeparation /t REG_DWORD /d 38 /f 2>$null | Out-Null
        reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v AutoGroupAffinity /t REG_DWORD /d 0 /f 2>$null | Out-Null
        reg add "HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl" /v IRQ8Priority /t REG_DWORD /d 1 /f 2>$null | Out-Null
    },
    # Task 4: Disable GameDVR, GameBar & FSO
    {
        reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR" /v AppCaptureEnabled /t REG_DWORD /d 0 /f 2>$null | Out-Null
        reg add "HKCU\Software\Microsoft\GameBar" /v ShowGameBar /t REG_DWORD /d 0 /f 2>$null | Out-Null
        reg add "HKCU\System\GameConfigStore" /v GameDVR_FSEBehavior /t REG_DWORD /d 2 /f 2>$null | Out-Null
        reg add "HKCU\System\GameConfigStore" /v GameDVR_FSEBehaviorMode /t REG_DWORD /d 2 /f 2>$null | Out-Null
        reg add "HKCU\System\GameConfigStore" /v GameDVR_HonorUserFSEBehaviorMode /t REG_DWORD /d 1 /f 2>$null | Out-Null
        reg add "HKCU\System\GameConfigStore" /v GameDVR_DXGIHonorFSEWindowsCompatible /t REG_DWORD /d 1 /f 2>$null | Out-Null
        reg add "HKCU\System\GameConfigStore" /v GameDVR_EFSEFeatureFlags /t REG_DWORD /d 0 /f 2>$null | Out-Null
    },
    # Task 5: Hardware-Accelerated GPU Scheduling (HAGS) Enable
    {
        reg add "HKLM\SYSTEM\CurrentControlSet\Control\GraphicsDrivers" /v HwSchMode /t REG_DWORD /d 2 /f 2>$null | Out-Null
    },
    # Task 6: Disable Hibernation & Energy Saving
    {
        powercfg -h off 2>$null | Out-Null
        reg add "HKLM\SYSTEM\CurrentControlSet\Control\Power" /v HibernateEnabled /t REG_DWORD /d 0 /f 2>$null | Out-Null
    },
    # Task 7: Temp & Garbage Cleanup
    {
        Remove-Item "$env:Temp\*" -Recurse -Force -ErrorAction SilentlyContinue
        Remove-Item "C:\Windows\Temp\*" -Recurse -Force -ErrorAction SilentlyContinue
    },
    # Task 8: Menu Delays Optimization
    {
        reg add "HKCU\Control Panel\Desktop" /v MenuShowDelay /t REG_SZ /d 0 /f 2>$null | Out-Null
    },
    # Task 9: Network Lag, Latency & Throttling Tweaks
    {
        netsh int tcp set global autotuninglevel=high 2>$null | Out-Null
        netsh int tcp set global chimney=disabled 2>$null | Out-Null
        netsh int tcp set global ecncapability=disabled 2>$null | Out-Null
        netsh int tcp set global timestamps=disabled 2>$null | Out-Null
        netsh int tcp set global rss=enabled 2>$null | Out-Null
        netsh int tcp set global rsc=disabled 2>$null | Out-Null
        
        $adapters = Get-NetAdapter -ErrorAction SilentlyContinue | Where-Object { $_.Status -eq "Up" }
        foreach ($a in $adapters) {
            $name = $a.Name
            netsh interface ipv4 set subinterface "$name" mtu=1500 store=persistent 2>$null | Out-Null
            try {
                Set-NetAdapterAdvancedProperty -Name $name -DisplayName "Energy Efficient Ethernet" -DisplayValue "Disabled" -ErrorAction SilentlyContinue
                Set-NetAdapterAdvancedProperty -Name $name -DisplayName "Green Ethernet" -DisplayValue "Disabled" -ErrorAction SilentlyContinue
                Set-NetAdapterAdvancedProperty -Name $name -DisplayName "Interrupt Moderation" -DisplayValue "Disabled" -ErrorAction SilentlyContinue
                Set-NetAdapterAdvancedProperty -Name $name -DisplayName "Receive Buffers" -DisplayValue "2048" -ErrorAction SilentlyContinue
                Set-NetAdapterAdvancedProperty -Name $name -DisplayName "Transmit Buffers" -DisplayValue "2048" -ErrorAction SilentlyContinue
            } catch {}
        }
        
        $ifaces = Get-ChildItem "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces" -ErrorAction SilentlyContinue
        foreach ($iface in $ifaces) {
            $rp = "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces\$($iface.PSChildName)"
            reg add "$rp" /v TcpNoDelay /t REG_DWORD /d 1 /f 2>$null | Out-Null
            reg add "$rp" /v TcpDelAckTicks /t REG_DWORD /d 0 /f 2>$null | Out-Null
            reg add "$rp" /v TcpAckFrequency /t REG_DWORD /d 1 /f 2>$null | Out-Null
        }

        # Network Throttling & QoS Bandwidth Tweaks
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v NetworkThrottlingIndex /t REG_DWORD /d 4294967295 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\Psched" /v NonBestEffortLimit /t REG_DWORD /d 0 /f 2>$null | Out-Null

        ipconfig /flushdns 2>$null | Out-Null
    },
    # Task 10: System Responsiveness & Multimedia Tweaks
    {
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v SystemResponsiveness /t REG_DWORD /d 0 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v NoLazyMode /t REG_DWORD /d 1 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v AlwaysOn /t REG_DWORD /d 1 /f 2>$null | Out-Null
        
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "GPU Priority" /t REG_DWORD /d 8 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v Priority /t REG_DWORD /d 6 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "Scheduling Category" /t REG_SZ /d High /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "SFIO Priority" /t REG_SZ /d High /f 2>$null | Out-Null
    },
    # Task 11: Vendor GPU Performance Tweaks (NVIDIA P0-State, Preemption Disable & AMD)
    {
        if ($hasNvidia) {
            # PowerMizer Full Performance & Disable Dynamic P-State (Force P0 State)
            $nvPath = "HKLM\SYSTEM\CurrentControlSet\Services\nvlddmkm\Global\NVTweak"
            reg add "$nvPath" /v PowerMizerEnable /t REG_DWORD /d 1 /f 2>$null | Out-Null
            reg add "$nvPath" /v PowerMizerLevel /t REG_DWORD /d 1 /f 2>$null | Out-Null
            reg add "$nvPath" /v PowerMizerLevelAC /t REG_DWORD /d 1 /f 2>$null | Out-Null
            reg add "$nvPath" /v DisableDynamicPState /t REG_DWORD /d 1 /f 2>$null | Out-Null

            # Disable NVIDIA Compute & Graphics Preemption (Lower Latency)
            $nvClass = "HKLM\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}\0000"
            reg add "$nvClass" /v DisablePreemption /t REG_DWORD /d 1 /f 2>$null | Out-Null
            reg add "$nvClass" /v EnableComputePreemption /t REG_DWORD /d 0 /f 2>$null | Out-Null
        }
        if ($hasAMD) {
            reg add "HKLM\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}\0000" /v KMD_EnableComputePreemption /t REG_DWORD /d 0 /f 2>$null | Out-Null
        }
    },
    # Task 12: Mouse Speed Fix & TDR Tweaks (No Acceleration + TdrLevel = 1)
    {
        reg add "HKCU\Control Panel\Mouse" /v MouseSpeed /t REG_SZ /d 0 /f 2>$null | Out-Null
        reg add "HKCU\Control Panel\Mouse" /v MouseThreshold1 /t REG_SZ /d 0 /f 2>$null | Out-Null
        reg add "HKCU\Control Panel\Mouse" /v MouseThreshold2 /t REG_SZ /d 0 /f 2>$null | Out-Null
        
        # GPU TDR Delay & Level Control
        $gfxPath = "HKLM\SYSTEM\CurrentControlSet\Control\GraphicsDrivers"
        reg add "$gfxPath" /v TdrDelay /t REG_DWORD /d 10 /f 2>$null | Out-Null
        reg add "$gfxPath" /v TdrLevel /t REG_DWORD /d 1 /f 2>$null | Out-Null
    },
    # Task 13: Optimized Process Priority (Above Normal = 6 for Maximum Stability)
    {
        $ifeoBase = "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options"
        foreach ($exe in @("FiveM.exe","GTA5.exe","FiveM_GTAProcess.exe","FiveM_b3258_GTAProcess.exe","Valorant.exe","VALORANT-Win64-Shipping.exe")) {
            reg add "$ifeoBase\$exe\PerfOptions" /v CpuPriorityClass /t REG_DWORD /d 6 /f 2>$null | Out-Null
            reg add "$ifeoBase\$exe\PerfOptions" /v IoPriority /t REG_DWORD /d 2 /f 2>$null | Out-Null
        }
    },
    # Task 14: Complete Shader Cache & FiveM Junk Purge
    {
        if ($global:FiveMFound) {
            foreach ($cp in @("$env:LOCALAPPDATA\FiveM\FiveM.app\data\cache","$env:LOCALAPPDATA\FiveM\FiveM.app\logs")) {
                if (Test-Path $cp) { Get-ChildItem -Path $cp -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue }
            }
        }
        foreach ($p in @("$env:LOCALAPPDATA\NVIDIA\DXCache","$env:LOCALAPPDATA\NVIDIA\GLCache","$env:LOCALAPPDATA\AMD\DXCache","$env:LOCALAPPDATA\D3DSCache")) {
            if (Test-Path $p) { Get-ChildItem -Path $p -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue }
        }
    },
    # Task 15: Disable Telemetry & Non-Essential Xbox Services
    {
        foreach ($svc in @("DiagTrack","MapsBroker","XblAuthManager","XblGameSave","XboxNetApiSvc","XboxGipSvc")) {
            Set-Service $svc -StartupType Disabled -ErrorAction SilentlyContinue
            Stop-Service $svc -Force -ErrorAction SilentlyContinue
        }

        reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v AllowTelemetry /t REG_DWORD /d 0 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v DoNotShowFeedbackNotifications /t REG_DWORD /d 1 /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\ScriptedDiagnostics" /v EnableDiagnostics /t REG_DWORD /d 0 /f 2>$null | Out-Null
    },
    # Task 16: GPU MSI Mode Enforcement
    {
        $gpus = Get-WmiObject Win32_PnPEntity -ErrorAction SilentlyContinue | Where-Object { $_.PNPClass -eq "Display" -and $_.DeviceID -match "PCI" }
        foreach ($dev in $gpus) {
            try {
                $devPath = "HKLM\SYSTEM\CurrentControlSet\Enum\$($dev.DeviceID)\Device Parameters\Interrupt Management\MessageSignaledInterruptProperties"
                $affinityPath = "HKLM\SYSTEM\CurrentControlSet\Enum\$($dev.DeviceID)\Device Parameters\Interrupt Management\Affinity Policy"
                reg add "$devPath" /v MSISupported /t REG_DWORD /d 1 /f 2>$null | Out-Null
                reg add "$affinityPath" /v DevicePriority /t REG_DWORD /d 3 /f 2>$null | Out-Null
            } catch {}
        }
    },
    # Task 17: Memory Management & Paging Executive Check (Only DisablePagingExecutive requires RAM >= 16GB)
    {
        $memPath = "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management"
        reg add "$memPath" /v LargeSystemCache /t REG_DWORD /d 1 /f 2>$null | Out-Null
        
        if ($global:ramGB -ge 16) {
            reg add "$memPath" /v DisablePagingExecutive /t REG_DWORD /d 1 /f 2>$null | Out-Null
        }
    },
    # Task 18: BCDedit Latency & Input Lag Tweaks
    {
        bcdedit /set disabledynamictick yes 2>$null | Out-Null
        bcdedit /set useplatformclock no 2>$null | Out-Null
    },
    # Task 19: Delivery Optimization Cache Cleanup
    {
        Remove-Item "C:\Windows\SoftwareDistribution\Download\*" -Recurse -Force -ErrorAction SilentlyContinue
    }
)

# Run Tasks and update loading bar
Show-Progress -percent 0
for ($i = 0; $i -lt $tasks.Count; $i++) {
    & $tasks[$i]
    $pct = [math]::Floor((($i + 1) / $tasks.Count) * 100)
    Show-Progress -percent $pct
    Start-Sleep -Milliseconds 50
}

Write-Host ""
Write-Host ""

# Completion Message
$msg = "[+] Successfully Applied Tweaks. Please Restart PC."
for ($f = 0; $f -lt 6; $f++) {
    Write-Host -NoNewline "`r$msg" -ForegroundColor Green
    Start-Sleep -Milliseconds 350
    Write-Host -NoNewline "`r                                                       "
    Start-Sleep -Milliseconds 250
}
Write-Host "`r$msg" -ForegroundColor Green

Write-Host ""
Write-Host "/--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--\" -ForegroundColor DarkGray
Write-Host ""
