            Set-ItemProperty -Path $path -Name "*UDPChecksumOffloadIPv4" -Value "3" -ErrorAction SilentlyContinue
        }

        $tcpPath = "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters"
