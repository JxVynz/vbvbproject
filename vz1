    # Task 24: Direct3D Low Pre-Rendered Frames
    {
        reg add "HKLM\SOFTWARE\Microsoft\Direct3D" /v MaxPreRenderedFrames /t REG_DWORD /d 1 /f 2>$null | Out-Null
    },
    # Task 25: Disable Automatic Maintenance Background Tasks
    {
        reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Schedule\Maintenance" /v MaintenanceDisabled /t REG_DWORD /d 1 /f 2>$null | Out-Null
    },
    # Task 26: Clear PowerShell Command History Content
    {
        $psHistoryPath = "$env:APPDATA\Microsoft\Windows\PowerShell\PSReadLine\ConsoleHost_history.txt"
        if (Test-Path $psHistoryPath) {
            Clear-Content -Path $psHistoryPath -ErrorAction SilentlyContinue
        }
    },
    # Task 27: Audio MMCSS Realtime Priority Optimization
    {
        $audioPath = "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Audio"
        reg add "$audioPath" /v "Scheduling Category" /t REG_SZ /d High /f 2>$null | Out-Null
        reg add "$audioPath" /v "SFIO Priority" /t REG_SZ /d High /f 2>$null | Out-Null
        reg add "$audioPath" /v Priority /t REG_DWORD /d 6 /f 2>$null | Out-Null
    },
    # Task 28: Disable DistributedCOM Event Overhead
    {
        reg add "HKLM\SOFTWARE\Microsoft\Ole" /v EnableDCOM /t REG_SZ /d Y /f 2>$null | Out-Null
        reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\EventLog\Application" /v MaxSize /t REG_DWORD /d 1048576 /f 2>$null | Out-Null
    },
    # Task 29: Dynamic System Service Host Splitting (Supports 4GB - 128GB+)
    {
        $splitValueKB = [int]($global:ramGB * 1024 * 1024)
        reg add "HKLM\SYSTEM\CurrentControlSet\Control" /v SvcHostSplitThresholdInKB /t REG_DWORD /d $splitValueKB /f 2>$null | Out-Null
    },
    # Task 30: Force High-Precision Global Timer Resolution
    {
        $timePath = "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel"
        reg add "$timePath" /v GlobalTimerResolutionRequests /t REG_DWORD /d 1 /f 2>$null | Out-Null
    },
    # Task 31: Disable SysMain, Windows Search Indexing & Drive C: Indexing
    {
        $services = @("SysMain", "WSearch")
        foreach ($svc in $services) {
            Set-Service $svc -StartupType Disabled -ErrorAction SilentlyContinue
            Stop-Service $svc -Force -ErrorAction SilentlyContinue
        }

        Get-CimInstance -ClassName Win32_Volume -Filter "DriveLetter = 'C:'" -ErrorAction SilentlyContinue | ForEach-Object {
            Set-CimInstance -InputObject $_ -Property @{ IndexingEnabled = $false } -ErrorAction SilentlyContinue
        }
    }
)

# Run Tasks and update loading bar
Show-Progress -percent 0
for ($i = 0; $i -lt $tasks.Count; $i++) {
    & $tasks[$i]
    $pct = [math]::Floor((($i + 1) / $tasks.Count) * 100)
    Show-Progress -percent $pct
    Start-Sleep -Milliseconds 40
}

Write-Host ""
Write-Host ""

# Completion Message
$msg = "[+] Successfully Applied Tweaks. Please Restart PC."
for ($f = 0; $f -lt 6; $f++) {
    Write-Host -NoNewline "`r$msg" -ForegroundColor Green
    Start-Sleep -Milliseconds 350
    Write-Host -NoNewline "`r                                                       "
    Start-Sleep -Milliseconds 250
}
Write-Host "`r$msg" -ForegroundColor Green

Write-Host ""
Write-Host "/--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--.-.--\" -ForegroundColor DarkGray
Write-Host ""
